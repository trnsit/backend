REPOSITORIES_DATABASE_URL=postgresql+psycopg://hisham_ali:hishamali123@postgres:5432/transit_repositories_db
SCANS_DATABASE_URL=postgresql+psycopg://hisham_ali:hishamali123@postgres:5432/transit_scans_db

# JWT CONFIG
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256

# GOOGLE OAUTH CONFIG
GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
