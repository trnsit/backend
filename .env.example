# APP CONFIG
DEBUG=true

# DATABASE CONFIGURATION (POSTGRESQL)
ACCOUNTS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transit_accounts_db
REPOSITORIES_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transit_repositories_db
SCANS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/transit_scans_db

# JWT AUTHENTICATION
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_32_byte_hex_secret_key_here
JWT_ALGORITHM=HS256

# GOOGLE OAUTH (ACCOUNTS SERVICE)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GITHUB OAUTH (ACCOUNTS & REPOSITORIES SERVICES)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# OLLAMA CONFIGURATION (INTELLIGENCE SERVICE)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# QDRANT & EMBEDDINGS (INTELLIGENCE SERVICE)
QDRANT_URL=http://localhost:6333
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
